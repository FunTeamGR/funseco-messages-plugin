{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "funseco/messages-plugin",
    "description": "Funseco messages — info messages, /chatlog, /msglog + message window, URL bot, login autocomplete",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "funseco/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Funseco\\Messages\\": "src/"
        }
    },
    "extra": {
        "funseco": {
            "id": "messages",
            "name": "Messages",
            "description": "messages — info messages, /chatlog, /msglog + message window, URL bot, login autocomplete",
            "provider": "Funseco\\Messages\\MessagesServiceProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "funseco/admin-plugin": "@dev",
        "funseco/guard-plugin": "@dev",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Funseco\\Messages\\Tests\\": "tests/"
        }
    }
}
